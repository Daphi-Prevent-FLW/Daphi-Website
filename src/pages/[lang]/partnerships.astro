---
// Route: /{lang}/partnerships/  (en + he). Two intent tiles, "Working with Daphi", pointer to the Data page.
// Section ids come from SECTION_IDS (other pages link to them).
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageHeading from '../../components/PageHeading.astro';
import IntentTiles from '../../components/IntentTiles.astro';
import PlaceholderMark from '../../components/PlaceholderMark.astro';
import { langStaticPaths, getDictionary, type Lang } from '../../i18n';
import { routePath } from '../../lib/routes';
import { buildMailto } from '../../lib/mailto';
import { stripPlaceholderMarkup } from '../../lib/placeholder';
import { SECTION_IDS } from '../../config/routes.mjs';

export function getStaticPaths() {
  return langStaticPaths();
}

const lang = Astro.params.lang as Lang;
const dict = getDictionary(lang);
const page = dict.pages.partnerships;
const { intent, working, dataPointer } = dict.partnerships;

const tiles = [
  { icon: 'link', href: routePath(lang, 'partnerships', SECTION_IDS.partnershipsWorkingWithDaphi), ...intent.tiles.clients },
  { icon: 'bars', href: routePath(lang, 'data', SECTION_IDS.dataShare), ...intent.tiles.data },
] as const;
const roles = ['technology', 'consultants', 'chefs', 'foodTech', 'others'] as const;
const model = ['model', 'eligibility', 'terms', 'start'] as const;
const mailHref = buildMailto({ subject: working.mailSubject, body: working.mailBody });
const dataHref = routePath(lang, 'data', SECTION_IDS.dataShare);
---

<BaseLayout lang={lang} routeId="partnerships">
  <PageHeading title={page.title} lead={page.lead} />

  <IntentTiles heading={intent.heading} tiles={tiles as any} />

  <!-- Section 2: working with Daphi -->
  <section class="container section" id={SECTION_IDS.partnershipsWorkingWithDaphi} aria-labelledby="working-heading">
    <h2 id="working-heading" class="section__heading">{working.heading}</h2>
    <p class="intro">{working.intro}</p>

    <h3>{working.rolesHeading}</h3>
    <ul class="roles">
      {roles.map((r) => <li>{working.roles[r]}</li>)}
    </ul>
    <p class="note">{working.rolesNote}</p>

    <h3>{working.modelHeading}</h3>
    <p>{working.modelIntro}</p>
    <ul class="model">
      {
        model.map((k) => (
          <li class="model__item">
            <h4>{working.model[k].title}</h4>
            <p>
              <PlaceholderMark lang={lang} />
              {stripPlaceholderMarkup(working.model[k].text)}
            </p>
          </li>
        ))
      }
    </ul>

    <div class="cta">
      <p>{working.note}</p>
      <a class="button" href={mailHref}>{working.link}</a>
    </div>
  </section>

  <!-- Section 3: data collaboration lives on the Data page (pointer only, no duplicated content) -->
  <section class="container section" id={SECTION_IDS.partnershipsDataCollaboration} aria-labelledby="data-pointer-heading">
    <div class="pointer">
      <h2 id="data-pointer-heading" class="pointer__heading">{dataPointer.heading}</h2>
      <p>{dataPointer.text}</p>
      <a class="button button--secondary" href={dataHref}>{dataPointer.link}</a>
    </div>
  </section>
</BaseLayout>

<style>
  .intro {
    font-size: var(--step-1);
    max-inline-size: 48rem;
  }
  .roles {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-xs);
    margin-block: 0 var(--space-s);
    margin-inline: 0;
    padding: 0;
    list-style: none;
  }
  .roles li {
    padding: var(--space-2xs) var(--space-s);
    border: var(--border-width) solid var(--color-border);
    border-radius: var(--radius-m);
    background: var(--color-surface);
  }
  .note {
    font-size: var(--step--1);
    color: var(--color-accent-text);
  }
  .model {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 15rem), 1fr));
    gap: var(--space-m);
    margin-block: 0 var(--space-l);
    margin-inline: 0;
    padding: 0;
    list-style: none;
  }
  .model__item {
    padding: var(--space-m);
    border: var(--border-width) dashed var(--color-border);
    border-radius: var(--radius-m);
  }
  .model__item h4 {
    font-size: var(--step-1);
  }
  .model__item p {
    margin: 0;
    font-size: var(--step--1);
  }
  .cta {
    padding: var(--space-l);
    border-radius: var(--radius-m);
    background: var(--color-strong);
    color: var(--color-on-strong);
  }
  .cta .button {
    background: var(--color-on-strong);
    color: var(--color-strong);
    border-color: var(--color-on-strong);
  }
  .cta .button:hover {
    background: var(--color-strong);
    color: var(--color-on-strong);
  }
  .cta .button:focus-visible {
    outline-color: var(--color-on-strong);
  }
  .pointer {
    padding: var(--space-m);
    border: var(--border-width) solid var(--color-border);
    border-inline-start-width: 0.5rem;
    border-radius: var(--radius-m);
    background: var(--color-surface);
  }
  .pointer__heading {
    font-size: var(--step-2);
  }
</style>
