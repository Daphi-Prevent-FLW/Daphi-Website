---
// Route: /{lang}/data/  (en + he). Three sections with stable ids (SECTION_IDS):
//   #explore-data         future platform (NOT deployed), doc link (only if configured), two mailto actions
//   #request-measurement  ask Daphi to measure data (mailto)
//   #share-data           share existing data (mailto); destination of the Partnerships data tile
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageHeading from '../../components/PageHeading.astro';
import JumpNav from '../../components/JumpNav.astro';
import PlaceholderMark from '../../components/PlaceholderMark.astro';
import { langStaticPaths, getDictionary, type Lang } from '../../i18n';
import { buildMailto } from '../../lib/mailto';
import { configuredHttpsUrl } from '../../lib/external';
import { stripPlaceholderMarkup } from '../../lib/placeholder';
import { siteConfig } from '../../config/site.config.mjs';
import { SECTION_IDS } from '../../config/routes.mjs';

export function getStaticPaths() {
  return langStaticPaths();
}

const lang = Astro.params.lang as Lang;
const dict = getDictionary(lang);
const page = dict.pages.data;
const { jump, jumpLabel, explore, measurement, share } = dict.data;

// Never render a link to a destination that has not been supplied (master prompt 11.1).
const docUrl = configuredHttpsUrl(siteConfig.futurePlatformDocUrl);
const notifyHref = buildMailto({ subject: explore.notify.mailSubject, body: explore.notify.mailBody });
const earlyHref = buildMailto({ subject: explore.early.mailSubject, body: explore.early.mailBody });
const measureHref = buildMailto({ subject: measurement.mailSubject, body: measurement.mailBody });
const shareHref = buildMailto({ subject: share.mailSubject, body: share.mailBody });
const jumpLinks = [
  { id: SECTION_IDS.dataExplore, label: jump.explore },
  { id: SECTION_IDS.dataMeasurement, label: jump.measurement },
  { id: SECTION_IDS.dataShare, label: jump.share },
];
---

<BaseLayout lang={lang} routeId="data">
  <PageHeading title={page.title} lead={page.lead} />

  <JumpNav label={jumpLabel} links={jumpLinks} />

  <!-- 1. Explore FLW granular data (platform not deployed) -->
  <section class="container section" id={SECTION_IDS.dataExplore} aria-labelledby="explore-heading">
    <h2 id="explore-heading" class="section__heading">{explore.heading}</h2>
    <p class="status" data-platform-state="not-deployed">{explore.status}</p>
    <p>{explore.text}</p>

    <ul class="actions">
      <li class="action" data-action="platform-doc" data-state={docUrl ? 'linked' : 'missing'}>
        {
          docUrl ? (
            <>
              <p>{explore.doc.text}</p>
              <a class="button button--secondary" href={docUrl} target="_blank" rel="noopener noreferrer">
                {explore.doc.label}
                <span class="visually-hidden"> {explore.doc.newTab}</span>
              </a>
            </>
          ) : (
            <>
              <p class="action__name">{explore.doc.label}</p>
              <p class="action__missing">
                <PlaceholderMark lang={lang} />
                {stripPlaceholderMarkup(explore.doc.missing)}
              </p>
            </>
          )
        }
      </li>
      <li class="action">
        <p>{explore.notify.text}</p>
        <a class="button" href={notifyHref}>{explore.notify.label}</a>
      </li>
      <li class="action">
        <p>{explore.early.text}</p>
        <a class="button" href={earlyHref}>{explore.early.label}</a>
      </li>
    </ul>
    <p class="note">{explore.note}</p>
  </section>

  <!-- 2. Request FLW data measurement -->
  <section class="container section" id={SECTION_IDS.dataMeasurement} aria-labelledby="measurement-heading">
    <div class="panel">
      <h2 id="measurement-heading" class="panel__heading">{measurement.heading}</h2>
      <p>{measurement.text}</p>
      <p class="note">{measurement.note}</p>
      <a class="button" href={measureHref}>{measurement.link}</a>
    </div>
  </section>

  <!-- 3. Share existing FLW data -->
  <section class="container section" id={SECTION_IDS.dataShare} aria-labelledby="share-heading">
    <h2 id="share-heading" class="section__heading">{share.heading}</h2>
    <p class="share__lead-in">{share.leadIn}</p>
    <p class="share__main">{share.main}</p>
    <p class="share__support">{share.support}</p>
    <p>{share.explanation}</p>
    <p class="note">{share.caveat}</p>
    <a class="button" href={shareHref}>{share.link}</a>
  </section>
</BaseLayout>

<style>
  .status {
    display: inline-block;
    margin-block-end: var(--space-xs);
    padding: var(--space-2xs) var(--space-s);
    border: var(--border-width) solid var(--color-strong);
    border-inline-start-width: 0.5rem;
    border-radius: var(--radius-s);
    font-family: var(--font-heading);
    font-size: var(--step-1);
  }
  .actions {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 16rem), 1fr));
    gap: var(--space-m);
    margin-block: var(--space-m) var(--space-s);
    margin-inline: 0;
    padding: 0;
    list-style: none;
  }
  .action {
    display: flex;
    flex-direction: column;
    gap: var(--space-s);
    padding: var(--space-m);
    border: var(--border-width) solid var(--color-border);
    border-radius: var(--radius-m);
    background: var(--color-surface);
  }
  .action p {
    margin: 0;
  }
  .action .button {
    margin-block-start: auto;
  }
  .action[data-state='missing'] {
    border-style: dashed;
  }
  .action__name {
    font-weight: 700;
  }
  .action__missing {
    font-size: var(--step--1);
  }
  .note {
    font-size: var(--step--1);
    color: var(--color-accent-text);
  }
  .panel {
    padding: var(--space-l);
    border-radius: var(--radius-m);
    background: var(--color-strong);
    color: var(--color-on-strong);
  }
  .panel__heading {
    color: var(--color-on-strong);
    max-inline-size: 40rem;
  }
  .panel .note {
    color: var(--color-on-strong);
  }
  .panel .button {
    background: var(--color-on-strong);
    color: var(--color-strong);
    border-color: var(--color-on-strong);
  }
  .panel .button:hover {
    background: var(--color-strong);
    color: var(--color-on-strong);
  }
  .panel .button:focus-visible {
    outline-color: var(--color-on-strong);
  }
  .share__lead-in {
    font-family: var(--font-heading);
    font-size: var(--step-1);
    margin-block-end: var(--space-2xs);
  }
  .share__main {
    font-family: var(--font-heading);
    font-size: var(--step-2);
    line-height: var(--leading-heading);
    margin-block-end: var(--space-2xs);
  }
  .share__support {
    font-size: var(--step-1);
  }
</style>
