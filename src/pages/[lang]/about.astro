---
// Route: /{lang}/about/  (en + he). Sections with stable ids (SECTION_IDS):
//   #our-story, #how-we-work   placeholder copy (structure only)
//   #timeline                  data-driven timeline (src/data/timeline.mjs) ending with the sensor funding appeal (#sensor-funding-about)
//   #contact                   email address
// The sensor texts and the funding appeal come from the shared source src/data/sensor.mjs (same as the Home page).
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageHeading from '../../components/PageHeading.astro';
import JumpNav from '../../components/JumpNav.astro';
import PlaceholderMark from '../../components/PlaceholderMark.astro';
import Timeline from '../../components/Timeline.astro';
import FundingCta from '../../components/FundingCta.astro';
import EmailLink from '../../components/EmailLink.astro';
import { langStaticPaths, getDictionary, type Lang } from '../../i18n';
import { stripPlaceholderMarkup } from '../../lib/placeholder';
import { SECTION_IDS } from '../../config/routes.mjs';

export function getStaticPaths() {
  return langStaticPaths();
}

const lang = Astro.params.lang as Lang;
const dict = getDictionary(lang);
const page = dict.pages.about;
const { jumpLabel, jump, story, how, timeline, contact } = dict.about;
const jumpLinks = [
  { id: SECTION_IDS.aboutStory, label: jump.story },
  { id: SECTION_IDS.aboutHow, label: jump.how },
  { id: SECTION_IDS.aboutTimeline, label: jump.timeline },
  { id: SECTION_IDS.aboutContact, label: jump.contact },
];
const textSections = [
  { id: SECTION_IDS.aboutStory, headingId: 'story-heading', content: story },
  { id: SECTION_IDS.aboutHow, headingId: 'how-heading', content: how },
];
---

<BaseLayout lang={lang} routeId="about">
  <PageHeading title={page.title} lead={page.lead} />
  <JumpNav label={jumpLabel} links={jumpLinks} />

  <!-- 1 + 2. Our story, How we work: placeholder paragraphs showing the intended structure -->
  {
    textSections.map((s) => (
      <section class="container section" id={s.id} aria-labelledby={s.headingId}>
        <h2 id={s.headingId} class="section__heading">{s.content.heading}</h2>
        {s.content.paragraphs.map((text) => (
          <p>
            <PlaceholderMark lang={lang} />
            {stripPlaceholderMarkup(text)}
          </p>
        ))}
      </section>
    ))
  }

  <!-- 3 + 4. Project timeline, ended by the sensor funding appeal -->
  <section class="container section" id={SECTION_IDS.aboutTimeline} aria-labelledby="timeline-heading">
    <h2 id="timeline-heading" class="section__heading">{timeline.heading}</h2>
    <p class="intro">{timeline.intro}</p>
    <Timeline lang={lang} labelledby="timeline-heading" />
    <div class="timeline-cta">
      <FundingCta lang={lang} kind="about" level={3} id={SECTION_IDS.aboutFunding} />
    </div>
  </section>

  <!-- 5. Contact us -->
  <section class="container section" id={SECTION_IDS.aboutContact} aria-labelledby="contact-heading">
    <h2 id="contact-heading" class="section__heading">{contact.heading}</h2>
    <p>{contact.text}</p>
    <EmailLink lang={lang} />
  </section>
</BaseLayout>

<style>
  .intro {
    font-size: var(--step-0);
    color: var(--color-text);
  }
  .timeline-cta {
    margin-block-start: var(--space-l);
  }
</style>
