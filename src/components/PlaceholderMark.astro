---
/**
 * Visible "placeholder" badge. Renders nothing when showPlaceholderMarkers is false in site.config.
 * Not colour-only: dashed border + text label.
 *   kind="text"       generic editorial placeholder (default)
 *   kind="statistic"  a statistic that must still be supplied
 *   kind="reference"  a reference that is not a verified source
 * See README "Placeholders".
 */
import { siteConfig } from '../config/site.config.mjs';
import { getDictionary, type Lang } from '../i18n';

interface Props {
  lang: Lang;
  kind?: 'text' | 'statistic' | 'reference';
}
const { lang, kind = 'text' } = Astro.props;
const dict = getDictionary(lang);
const label = { text: dict.ui.placeholderBadge, statistic: dict.ui.placeholderBadgeStat, reference: dict.ui.placeholderBadgeRef }[kind];
---

{siteConfig.showPlaceholderMarkers && <span class="placeholder-badge" data-placeholder={kind}>{label}</span>}

<style>
  .placeholder-badge {
    display: inline-block;
    padding: 0 var(--space-2xs);
    border: 2px dashed var(--color-accent);
    border-radius: var(--radius-s);
    color: var(--color-accent-text);
    background: var(--color-surface);
    font-size: var(--step--1);
    font-weight: 700;
    line-height: 1.6;
    vertical-align: baseline;
    white-space: nowrap;
  }
</style>
