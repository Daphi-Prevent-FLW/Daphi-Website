---
/**
 * Stub body used by the pages that do not have real content yet: heading + lead + a clearly marked
 * placeholder notice. Removed from each page as it gets its real content (still used by About and
 * Acknowledgments until Stage 5).
 */
import PageHeading from './PageHeading.astro';
import PlaceholderMark from './PlaceholderMark.astro';
import { stripPlaceholderMarkup } from '../lib/placeholder';
import { getDictionary, type Lang } from '../i18n';
import type { RouteId } from '../lib/routes';

interface Props {
  lang: Lang;
  routeId: RouteId;
}
const { lang, routeId } = Astro.props;
const dict = getDictionary(lang);
const page = dict.pages[routeId];
---

<PageHeading title={page.title} lead={page.lead} />
<section class="container stub">
  <p>
    <PlaceholderMark lang={lang} />
    {stripPlaceholderMarkup(dict.stub.notice)}
  </p>
</section>
