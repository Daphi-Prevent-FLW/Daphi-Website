---
/**
 * <head> contents: title, description, favicon, font preloads, Open Graph, Twitter.
 *
 * Behaviour depends on siteUrl (src/config/site.config.mjs):
 *  - SET:   absolute canonical, absolute hreflang alternates (one per language + x-default), og:url, og:image (only if a
 *           raster image exists at assets.ogImage).
 *  - UNSET: NO canonical, NO hreflang/x-default, NO og:url, NO og:image. Reason: all of these must be absolute URLs;
 *           root-relative values are invalid for hreflang and ignored or misread by crawlers, so omitting them is the
 *           only correct output. Title, description, og:title/description/locale/type/site_name and robots stay.
 * x-default points at the language entry page ("/"), which presents the choice of language (README, "Routing and
 * localization"): Part A does not name a default language, so none is assumed here.
 */
import { siteConfig } from '../config/site.config.mjs';
import { normalizeSiteUrl } from '../config/site-url.mjs';
import { LANGS, getDictionary, type Lang } from '../i18n';
import { resolveBrandAsset } from '../lib/brand';
import { routePath, rootPath, withBase, type RouteId } from '../lib/routes';

interface Props {
  lang: Lang;
  routeId: RouteId;
  title: string;
  description: string;
}
const { lang, routeId, title, description } = Astro.props;

const site = normalizeSiteUrl(siteConfig.siteUrl);
const abs = (path: string) => site + path;

const selfPath = routePath(lang, routeId);
const canonical = site ? abs(selfPath) : null;
const alternates = site ? LANGS.map((code) => ({ code, href: abs(routePath(code, routeId)) })) : [];
const xDefault = site ? abs(rootPath()) : null;

// Open Graph crawlers do not render SVG: only use a raster image, and only with an absolute URL.
const ogAsset = resolveBrandAsset(siteConfig.assets.ogImage);
const og = site && ogAsset && /\.(png|jpe?g|webp)$/i.test(ogAsset.src) ? ogAsset : null;
const dict = getDictionary(lang);
const otherLocales = LANGS.filter((c) => c !== lang).map((c) => getDictionary(c).lang.ogLocale);

// Preload only the Latin face (all pages contain Latin glyphs) plus the Hebrew face on /he/ pages.
const fontPreloads = [
  'secular-one-latin-400-normal.woff2',
  'varela-round-latin-400-normal.woff2',
  ...(lang === 'he' ? ['secular-one-hebrew-400-normal.woff2', 'varela-round-hebrew-400-normal.woff2'] : []),
];
---

<meta charset="utf-8" />
<meta name="viewport" content="width=device-width, initial-scale=1" />
<title>{title}</title>
<meta name="description" content={description} />
<meta name="theme-color" content="#f9f6e9" />

{canonical && <link rel="canonical" href={canonical} />}
{alternates.map((a) => <link rel="alternate" hreflang={a.code} href={a.href} />)}
{xDefault && <link rel="alternate" hreflang="x-default" href={xDefault} />}

<link rel="icon" href={withBase('favicon.svg')} type="image/svg+xml" />
{
  fontPreloads.map((file) => (
    <link rel="preload" href={withBase(`fonts/${file}`)} as="font" type="font/woff2" crossorigin />
  ))
}

<meta property="og:type" content="website" />
<meta property="og:site_name" content={dict.meta.siteName} />
<meta property="og:title" content={title} />
<meta property="og:description" content={description} />
<meta property="og:locale" content={dict.lang.ogLocale} />
{otherLocales.map((l) => <meta property="og:locale:alternate" content={l} />)}
{canonical && <meta property="og:url" content={canonical} />}
{og && <meta property="og:image" content={abs(og.src)} />}
<meta name="twitter:card" content={og ? 'summary_large_image' : 'summary'} />
<meta name="twitter:title" content={title} />
<meta name="twitter:description" content={description} />
{og && <meta name="twitter:image" content={abs(og.src)} />}
