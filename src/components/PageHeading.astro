---
/** Reusable page hero: the single <h1> of a page, an optional lead paragraph and a short accent rule. */
interface Props {
  title: string;
  lead?: string;
}
const { title, lead } = Astro.props;
---

<header class="page-heading">
  <div class="container">
    <h1>{title}</h1>
    {lead && <p class="lead">{lead}</p>}
  </div>
</header>

<style>
  .page-heading {
    padding-block: var(--space-xl) var(--space-l);
  }
  /* Short accent rule: decorative, aligned to the inline start in both directions. */
  h1::after {
    content: '';
    display: block;
    inline-size: 4rem;
    block-size: 6px;
    margin-block-start: var(--space-s);
    background: var(--color-accent);
    border-radius: 3px;
  }
  .lead {
    margin-block-start: var(--space-s);
    font-size: var(--step-1);
    color: var(--color-text);
  }
</style>
