---
import EmailLink from './EmailLink.astro';
import LanguageSwitcher from './LanguageSwitcher.astro';
import { getDictionary, type Lang } from '../i18n';
import { routePath, navRoutes, type RouteId } from '../lib/routes';

interface Props {
  lang: Lang;
  routeId: RouteId;
}
const { lang, routeId } = Astro.props;
const dict = getDictionary(lang);
---

<footer class="site-footer">
  <div class="container footer-inner">
    <section class="footer-contact" aria-labelledby="footer-contact-heading">
      <h2 id="footer-contact-heading" class="footer-heading">{dict.ui.contactHeading}</h2>
      <EmailLink lang={lang} />
    </section>

    <nav class="footer-nav" aria-label={dict.ui.footerNavLabel}>
      <ul>
        {
          navRoutes.map((route) => (
            <li>
              <a href={routePath(lang, route.id)} aria-current={route.id === routeId ? 'page' : undefined}>
                {dict.nav[route.id]}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>

    <div class="footer-lang">
      <LanguageSwitcher lang={lang} routeId={routeId} />
    </div>

    <p class="footer-copy">{dict.ui.copyright}</p>
  </div>
</footer>

<style>
  .site-footer {
    margin-block-start: var(--space-2xl);
    padding-block: var(--space-l);
    background: var(--color-surface);
    border-block-start: 4px solid var(--color-accent);
  }
  .footer-inner {
    display: grid;
    gap: var(--space-m);
  }
  .footer-heading {
    margin-block-end: var(--space-3xs);
    font-family: var(--font-body);
    font-size: var(--step-0);
    font-weight: 700;
  }
  .footer-nav ul {
    display: flex;
    flex-wrap: wrap;
    gap: 0 var(--space-m);
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .footer-nav a {
    display: inline-flex;
    align-items: center;
    min-block-size: var(--touch-target);
    font-size: var(--step--1);
  }
  .footer-nav a[aria-current='page'] {
    font-weight: 700;
    text-decoration-thickness: 0.2em;
  }
  .footer-copy {
    margin: 0;
    font-size: var(--step--1);
    color: var(--color-accent-text);
  }

  @media (min-width: 48em) {
    .footer-inner {
      grid-template-columns: 1fr auto;
      align-items: start;
    }
    .footer-nav {
      grid-column: 1;
    }
    .footer-lang {
      grid-column: 2;
      grid-row: 1 / span 2;
      justify-self: end;
    }
    .footer-copy {
      grid-column: 1 / -1;
    }
  }
</style>
