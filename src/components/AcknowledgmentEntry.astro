---
/**
 * One contributor. Conditional rendering (nothing empty, nothing inactive):
 *   no picture   -> no <img> and no empty circle        (resolved at build time; a missing file counts as no picture)
 *   no linkedin  -> the name is plain text; with it the NAME is the link
 *   no website   -> no website icon
 *   no email     -> no email icon
 * Order: picture, name, website icon, email icon, as a flex row. The row follows the page direction, so the
 * picture sits at the inline start (left in LTR, right in RTL) and the rest follows it with no direction-specific CSS.
 * Icons: original generic inline SVG glyphs (website, email); the official email icon is used when its file exists.
 * Pictures are decorative here (the name is right next to them), so alt="".
 */
import PlaceholderMark from './PlaceholderMark.astro';
import { siteConfig } from '../config/site.config.mjs';
import { resolveBrandAsset } from '../lib/brand';
import { entryLinks, type Acknowledgment } from '../lib/acknowledgments';
import { localized } from '../lib/references';
import { stripPlaceholderMarkup } from '../lib/placeholder';
import { getDictionary, type Lang } from '../i18n';

interface Props {
  lang: Lang;
  entry: Acknowledgment;
}
const { lang, entry } = Astro.props;
const d = getDictionary(lang).acknowledgments;
const name = stripPlaceholderMarkup(localized(entry.name, lang));
const picture = entry.picture ? resolveBrandAsset(entry.picture) : null;
const links = entryLinks(entry);
const emailIcon = links.email ? resolveBrandAsset(siteConfig.assets.emailIcon) : null;
---

<li class="ack" data-status={entry.status} id={`ack-${entry.id}`}>
  {picture && <img class="ack__photo" src={picture.src} width="64" height="64" alt="" loading="lazy" decoding="async" />}

  <p class="ack__name">
    {entry.status === 'placeholder' && <PlaceholderMark lang={lang} />}
    {
      links.linkedin ? (
        <a href={links.linkedin} target="_blank" rel="noopener noreferrer">
          <bdi>{name}</bdi>
          <span class="visually-hidden"> ({d.linkedin}, {d.newTab})</span>
        </a>
      ) : (
        <bdi>{name}</bdi>
      )
    }
  </p>

  {
    (links.website || links.email) && (
      <p class="ack__icons">
        {
          links.website && (
            <a class="ack__icon" href={links.website} target="_blank" rel="noopener noreferrer" aria-label={`${d.website}: ${name} ${d.newTab}`}>
              <svg viewBox="0 0 24 24" width="24" height="24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false">
                <circle cx="12" cy="12" r="9" />
                <path d="M3 12h18" />
                <path d="M12 3c2.6 2.7 3.9 5.7 3.9 9s-1.3 6.3-3.9 9c-2.6-2.7-3.9-5.7-3.9-9S9.4 5.7 12 3z" />
              </svg>
            </a>
          )
        }
        {
          links.email && (
            <a class="ack__icon" href={links.email.href} aria-label={`${d.email}: ${name}`}>
              {emailIcon ? (
                <img src={emailIcon.src} alt="" width={emailIcon.width} height={emailIcon.height} aria-hidden="true" />
              ) : (
                <svg viewBox="0 0 24 24" width="24" height="24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false">
                  <rect x="3" y="5" width="18" height="14" rx="2" />
                  <path d="M3.5 6.5l8.5 6.5 8.5-6.5" />
                </svg>
              )}
            </a>
          )
        }
      </p>
    )
  }
</li>

<style>
  .ack {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-xs) var(--space-s);
    padding: var(--space-s) var(--space-m);
    border: var(--border-width) solid var(--color-border);
    border-radius: var(--radius-m);
    background: var(--color-surface);
  }
  .ack[data-status='placeholder'] {
    border-style: dashed;
    background: transparent;
  }
  .ack__photo {
    flex: none;
    inline-size: 4rem;
    block-size: 4rem;
    border-radius: 50%;
    object-fit: cover;
    border: var(--border-width) solid var(--color-border);
  }
  .ack__name {
    flex: 1 1 8rem;
    min-inline-size: 0;
    margin: 0;
    font-weight: 700;
  }
  .ack__icons {
    display: flex;
    gap: var(--space-3xs);
    margin: 0;
  }
  .ack__icon {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    inline-size: var(--touch-target);
    block-size: var(--touch-target);
    border-radius: 50%;
    color: var(--color-text);
  }
  .ack__icon:hover {
    background: var(--color-strong);
    color: var(--color-on-strong);
  }
  .ack__icon img {
    display: block;
    inline-size: 1.5rem;
    block-size: 1.5rem;
    /* Official icon is intentionally not mirrored. */
  }
</style>
