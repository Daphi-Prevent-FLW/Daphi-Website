{
  // Cloudflare static-assets deployment for the built Astro site (output: ./dist).
  // Account-specific steps (login, project creation, custom domain) are described in README.md.
  // When merging into the existing Daphi repository, reconcile this file with any existing wrangler config.
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "daphi-website",
  "compatibility_date": "2026-10-01",
  "assets": {
    "directory": "./dist",
    "not_found_handling": "404-page"
  },
  "previews": {},
  "observability": {
    "logs": {
      "enabled": true,
      "head_sampling_rate": 1,
      "invocation_logs": true,
      "persist": true
    },
    "traces": {
      "enabled": false,
      "head_sampling_rate": 1,
      "persist": true
    }
  }
}
