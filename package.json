{
  "name": "daphi-website",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Daphi: bilingual (EN/HE) informational website for a food loss and waste prevention nonprofit.",
  "engines": {
    "node": ">=22.22.0"
  },
  "scripts": {
    "dev": "astro dev",
    "build": "astro build && node scripts/check-routes.mjs",
    "preview": "astro preview",
    "check": "astro check",
    "check:routes": "node scripts/check-routes.mjs",
    "validate": "npm run check:contrast && npm run test:mailto && npm run check:routes",
    "sync:fonts": "node scripts/sync-fonts.mjs",
    "check:contrast": "node scripts/check-contrast.mjs",
    "test:mailto": "node scripts/test-mailto.mjs"
  },
  "dependencies": {
    "@astrojs/sitemap": "^3.7.4",
    "astro": "^7.4.0"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.10",
    "@fontsource/secular-one": "^5.3.0",
    "@fontsource/varela-round": "^5.3.0",
    "typescript": "^5.9.0"
  }
}
